# ---- Database ----
# SQLite for local/dev (zero setup). Swap to a Postgres URL + change the
# provider in prisma/schema.prisma to "postgresql" for production.
DATABASE_URL="file:./dev.db"

# ---- Auth ----
# Random 32+ byte secret used to sign session JWTs. Generate with:
#   openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Money verification (live revenue) ----
# Real Stripe Connect keys let the app pull live MRR from a seller's own
# Stripe account for the hallmark check. Leave blank to run in demo mode,
# where sellers self-report and listings are marked "unverified (demo)".
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_CONNECT_CLIENT_ID=""

# ---- Escrow ----
# IMPORTANT: real fund custody (holding a buyer's money until handover) is a
# money-transmission activity in most jurisdictions and needs legal review
# before it touches real funds — see assay/README.md. Until that review is
# done, leave this as "stub": the full escrow/dispute state machine runs and
# is fully testable, it just never calls a real payments API.
ESCROW_MODE="stub" # "stub" | "stripe"

# ---- KYC ----
# Same caution as escrow: real identity verification needs a KYC/AML review.
# "stub" auto-approves in dev so you can exercise every screen; "manual"
# requires an admin to approve from /admin/kyc; "persona" is a real adapter
# stub ready for you to wire up Persona/Stripe Identity keys into.
KYC_MODE="stub" # "stub" | "manual" | "persona"
PERSONA_API_KEY=""

# ---- Rate limiting ----
# Optional — in-memory limiter is used by default (fine for a single
# instance / demo). Set these to move to Upstash Redis for production
# (multi-instance) deployments.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
