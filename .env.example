PORT=3002
CORS_ORIGIN=http://localhost:5174

# Generate a fixed 64-char random string and keep it stable across restarts —
# rotating it logs every user out.
JWT_SECRET=

# Stripe (test mode keys while developing)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Email (leave blank in dev — verification codes / reset links print to the
# server console instead of being sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BATCH <noreply@batch.app>

APP_URL=http://localhost:5174
