{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": false,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "server/**/*.js"],
  "exclude": ["node_modules", "dist", "data", "public/tools", "master-security-template", "server/test"]
}
